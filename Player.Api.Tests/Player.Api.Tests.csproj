<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by xUnit v3: the test project is a self-executing host. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Player.Api.Tests</RootNamespace>

    <!--
      Microsoft.Testing.Platform (global.json test.runner): the test project runs as its own test app, under
      `dotnet test` and `dotnet run` alike. xunit.v3 4 and later only run this way on the .NET 10 SDK.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <!-- Used by nearly every test file; importing them globally keeps the noise down. -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
    <!-- The shared harness in Support/Shared (agent-docs/api-testing). -->
    <Using Include="Crucible.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="NSubstitute" />
    <!-- Hosts Player.Api in-process over TestServer, so the tests drive the real Startup. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Connects real SignalR clients to the in-process hubs, for their [Authorize] tests. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Player.Api\Player.Api.csproj" />
  </ItemGroup>

</Project>
