<?xml version="1.0" encoding="utf-8" ?>
<!--
  Scopes coverage to code this repository actually writes and could plausibly test.

  Without this, the reported figure is dominated by things no test drives: the generated migration
  assembly alone is ~57,000 of ~73,000 sequence points and scores ~97%, purely because the test
  harness calls Migrate() on a real database. That put the headline at 78% while the application
  itself sat at 6%, which is worse than having no number at all.

  Pass it with the `settings` argument to `dotnet test`, as the CI workflow does.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!--
            Assembly-level exclusions. Migrations are generated by `dotnet ef migrations add` and
            re-generated wholesale; asserting on them would pin EF's output, not our behaviour.
            The test assembly excludes itself.
          -->
          <Exclude>[Player.Api.Migrations.PostgreSQL]*,[Player.Api.Tests]*</Exclude>

          <!--
            File-level exclusions, for third-party code that compiles into our assemblies rather
            than arriving as a reference:

            - Crucible.Common.EntityEvents ships its implementation as `contentFiles`, so it
              compiles straight into Player.Api.Data and no assembly filter can reach it. ~518
              sequence points of someone else's library.
            - The Migrations belt-and-braces entry, in case a migration is ever added to another
              assembly.
          -->
          <ExcludeByFile>**/.nuget/packages/**/*.cs,**/Migrations/**/*.cs</ExcludeByFile>

          <!--
            Generated code is excluded by attribute rather than by path, which catches source
            generators and the compiler's own output wherever they land.
          -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute,Obsolete</ExcludeByAttribute>

          <!--
            Auto-implemented property accessors are not logic and cannot fail. Counting them let a
            DTO with 40 properties look like meaningful coverage the moment one mapping test touched
            it, which is most of the 3-8% the Features folders reported.
          -->
          <SkipAutoProps>true</SkipAutoProps>

          <!-- Attribute-driven; keeps the report to code we could act on. -->
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
