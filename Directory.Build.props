<!--
  Settings every project in the repository shares. Imported before each project file, so a project
  that needs something different can still override it.
-->
<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>

    <!--
      A warning that nobody has to act on is a warning nobody reads, and the compiler and the xUnit
      analyzers report real defects: an unawaited task, a [Theory] with no data, an assertion that
      cannot fail. The build is clean today, so this keeps it that way rather than paying off a
      backlog.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Restore-time warnings stay warnings. These report facts about dependencies rather than defects
      in this code, and none of them can be fixed here today:

      - NU1901-NU1904 are the NuGet audit. AutoMapper 13 and MediatR 12 are pinned deliberately
        (later versions require a commercial license), so the audit has findings that a build failure
        would only make invisible by blocking every build.
      - NU1701 is TinCan 1.3.0, which ships only .NET Framework assets and has no .NET replacement.
    -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;NU1701</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
